{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Demo manifest",
  "type": "object",
  "required": ["demos"],
  "properties": {
    "demos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Folder name under demos/ and the URL segment: /demos/<slug>/"
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date, used for sorting on the landing page (newest first)."
          },
          "article": {
            "type": ["string", "null"],
            "description": "Optional URL of the write-up this demo belongs to."
          },
          "status": {
            "enum": ["live", "draft"],
            "description": "draft demos are still built but hidden from the landing page."
          }
        }
      }
    }
  }
}
